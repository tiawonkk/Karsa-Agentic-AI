# ==============================================================================
# PROJECT KARSA — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi `.env` lalu masukkan API key Anda.

# 1. GEMINI API KEY (UTAMA / DIREKOMENDASIKAN - GRATIS)
# Dapatkan di: https://aistudio.google.com/apikey
KARSA_GEMINI_API_KEY=your_gemini_api_key_here

# 2. DEEPSEEK API KEY (OPSIONAL - CLOUD REASONING)
# Dapatkan di: https://platform.deepseek.com/
KARSA_DEEPSEEK_API_KEY=

# 3. OLLAMA LOKAL (UNTUK HERMES 3 & DEEPSEEK LOKAL)
KARSA_OLLAMA_BASE_URL=http://localhost:11434
KARSA_COUNCIL_WORKER_MODEL=hermes3:8b
KARSA_COUNCIL_REASONER_MODEL=deepseek-r1:8b
KARSA_COUNCIL_REASONER_PROVIDER=ollama
KARSA_COUNCIL_SYNTH_MODEL=gemini-2.0-flash

# 4. ANTHROPIC CLAUDE (OPSIONAL)
KARSA_ANTHROPIC_API_KEY=

# 5. SERVER & SYSTEM
KARSA_HARDWARE_OVERRIDE=auto
KARSA_HOST=127.0.0.1
KARSA_PORT=8765
